doctype html
html.govuk-template(lang='en')
  head
    meta(charset='utf-8')
    block title
      title Example
    link(href='/assets/stylesheets/main.css', media='screen', rel='stylesheet')
    link(rel='mask-icon', href='/assets/stylesheets/lib/images/gov.uk_logotype_crown.svg', color='#0b0c0c')
    link(rel='apple-touch-icon-precomposed', sizes='152x152', href='/assets/stylesheets/lib/images/apple-touch-icon-152x152.png')
    link(rel='apple-touch-icon-precomposed', sizes='120x120', href='/assets/stylesheets/lib/images/apple-touch-icon-120x120.png')
    link(rel='apple-touch-icon-precomposed', sizes='76x76', href='/assets/stylesheets/lib/images/apple-touch-icon-76x76.png')
    link(rel='apple-touch-icon-precomposed', href='/assets/stylesheets/images/apple-touch-icon-60x60.png')
    link(href='https://maxcdn.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css', rel='stylesheet')
    link(href='/assets/stylesheets/lib/HTMLCSAuditor.css', rel='stylesheet')
    base(href='/')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    meta(property='og:image', content='/assets/stylesheets/lib/images/opengraph-image.png')
    style(type='text/css').
      .content {
        min-height: 400px;
      }
      .bar-header a {
        color: #ffffff;
      }
      .bar-header .title {
        padding: 0;
        text-align: left;
      }
      .bar-header .title a.content {
        padding: 0;
      }
      .second-nav__menu::after {
        clear: both;
        content: '';
        display: table;
      }
      .advanced-search {
        display: -webkit-inline-box;
        display: -ms-inline-flexbox;
        display: inline-flex;
      }
      .advanced-search::after {
        clear: both;
        content: "";
        display: table;
      }
      .advanced-search input[type=search] {
        float: left;
        border: 3px solid black;
        border-right: 0;
        height: 30px;
        padding: 0 2px;
      }
      .magnifier {
        background: black;
        cursor: pointer;
        padding: 5px;
        width: 20px;
        height: 20px;
        float: left;
        border: 3px solid black;
      }
      .help-block {
        background-color: rgba(222, 224, 226, 1);
        height: 157px;
        font-size: 16px;
        padding: 10px 20px 10px 20px;
      }
      .logout-btn {
        cursor: pointer;
      }
  body.govuk-template__body
    .govuk-width-container
      .govuk-phase-banner
        p.govuk-phase-banner__content
          strong.govuk-tag.govuk-phase-banner__content__tag ALPHA
          span.govuk-phase-banner__text
            | This is a new service – your
            a.govuk-link(href='#') feedback
            |  will help us to improve it.
    a.govuk-skip-link(href='#content', data-module='govuk-skip-link') Skip to main content
    header#global-header(role='banner')
      .bar-header
        .govuk-width-container
          ul.bar-header__list.bar-header-left
            li.title
              a.content(routerlink='/', title='Go to the GOV.UK homepage')
                span#proposition-name Paybubble - Telephony payments
          ul.bar-header__list.bar-header-right
            li #{ moment().format('DD/MMM/YYYY') }
    main#content(role='main')
      div(class="second-nav blue")
        .second-nav__menu
          span &nbsp;
      .govuk-width-container
        .content
          block body
        .help-block
          p
            b
              | Help
          p
            | Email: service-desk@hmcts.gsi.gov.uk
          p
            | Phone: 0207 633 4140
          p
            | Monday to Friday, 8am to 6pm (excluding bank holidays)

    footer.govuk-footer(role='contentinfo')
      .govuk-width-container
        .govuk-footer__meta
          .govuk-footer__meta-item.govuk-footer__meta-item--grow
            p.govuk-footer__licence-description
              | All content is available under the
              a.govuk-footer__link(href='https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/', rel='license')  Open Government Licence v3.0
              | , except where otherwise stated
          .govuk-footer__meta-item
            a.govuk-footer__copyright-logo(href='http://www.nationalarchives.gov.uk/information-management/re-using-public-sector-information/copyright-and-re-use/crown-copyright/') © Crown copyright
