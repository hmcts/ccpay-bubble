{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "module": "es2022",
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "resolveJsonModule": true,
    "target": "es2022",
    "typeRoots": [
      "node_modules/@types"
    ],
    "paths": {
      "view-payment": [
        "./dist/view-payment"
      ],
      "view-payment/*": [
        "./dist/view-payment/*"
      ],
      "fee-register-search": [
        "./dist/fee-register-search"
      ],
      "fee-register-search/*": [
        "./dist/fee-register-search/*"
      ],
      "src/*": [
        "./src/*"
      ],
      "projects/*": [
        "./projects/*"
      ]
    },
    "strict": false
  }
}
